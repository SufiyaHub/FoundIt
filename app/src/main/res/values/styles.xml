<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FoundIt" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/foundit_accent</item>
        <item name="colorPrimary">@color/foundit_primary</item>
        <item name="colorPrimaryDark">@color/foundit_primary_dark</item>
        <item name="colorSecondary">@color/foundit_accent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Theme.FoundIt.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/foundit_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/foundit_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/foundit_black</item>
        <item name="postSplashScreenTheme">@style/Theme.FoundIt</item>
    </style>

    <style name="Widget.FoundIt.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="backgroundTint">@color/foundit_primary</item>
        <item name="android:textColor">@color/foundit_text</item>
    </style>
</resources>
